@model BloodConnect.Models.BloodRequest

@{
    ViewData["Title"] = "Delete Blood Request";
}

<!-- ============ PAGE HEADER ============ -->
<section class="page-header py-4 mb-4">
    <div class="container">
        <h1 class="h3 fw-bold mb-1 text-danger">Delete Blood Request</h1>
        <p class="text-muted mb-0 small">
            This action cannot be undone
        </p>
    </div>
</section>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="alert alert-danger border-0 rounded-4 p-4 mb-4" role="alert">
                <h2 class="h5 fw-bold mb-2">⚠️ Are you sure?</h2>
                <p class="mb-0">
                    Deleting this request will permanently remove it from the system.
                    If you just want to mark it as complete, use <strong>Mark Fulfilled</strong> instead.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h2 class="h6 fw-bold mb-4 text-uppercase text-muted">
                        Request details
                    </h2>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Request ID</dt>
                        <dd class="col-sm-8 fw-semibold">#@Model.RequestId</dd>

                        <dt class="col-sm-4 text-muted">Requester</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.RequesterName</dd>

                        <dt class="col-sm-4 text-muted">Blood group</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                @Model.BloodGroupNeeded
                            </span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Location</dt>
                        <dd class="col-sm-8">@Model.Location</dd>

                        <dt class="col-sm-4 text-muted">Urgency</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-@(Model.UrgencyLevel switch {
                                "Critical" => "danger",
                                "High"     => "warning text-dark",
                                "Medium"   => "info text-dark",
                                _          => "secondary"
                            })">@Model.UrgencyLevel</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-@(Model.Status == "Open" ? "primary" : "success")">
                                @Model.Status
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="d-flex gap-2 mt-4">
                <input type="hidden" asp-for="RequestId" />
                <button type="submit" class="btn btn-danger btn-lg">
                    Yes, Delete Request
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>