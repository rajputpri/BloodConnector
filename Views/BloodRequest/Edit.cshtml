@model BloodConnect.Models.BloodRequest

@{
    ViewData["Title"] = "Edit Blood Request";
}

<!-- ============ PAGE HEADER ============ -->
<section class="page-header py-4 mb-4">
    <div class="container">
        <h1 class="h3 fw-bold mb-1">Edit Blood Request #@Model.RequestId</h1>
        <p class="text-muted mb-0 small">
            Update the request details. Status and dates are system-managed.
        </p>
    </div>
</section>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post" novalidate>
                        <input type="hidden" asp-for="RequestId" />

                        <partial name="_Form" model="Model" />

                        <div class="d-flex gap-2 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-danger btn-lg flex-grow-1">
                                Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}