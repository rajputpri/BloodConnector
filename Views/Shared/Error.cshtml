@model BloodConnect.Models.ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    var statusCode = ViewBag.StatusCode as int?;
    var isNotFound = statusCode == 404;
    var isServer = statusCode >= 500;
}

<section class="error-hero">
    <div class="container">
        <div class="error-content">

            @if (isNotFound)
            {
                <div class="error-code">404</div>
                <h1>This page went missing.</h1>
                <p>
                    The page you're looking for doesn't exist, was moved, or the link is broken.
                    Let's get you back on track.
                </p>
            }
            else if (isServer)
            {
                <div class="error-code">@statusCode</div>
                <h1>Something broke on our end.</h1>
                <p>
                    We're aware and working on it. Try again in a moment — if it persists,
                    please let us know.
                </p>
            }
            else
            {
                <div class="error-code">!</div>
                <h1>An unexpected error occurred.</h1>
                <p>
                    Something didn't go as planned. Please try again, or head back home.
                </p>
            }

            <div class="error-actions">
                <a asp-controller="Home" asp-action="Index" class="btn-cta-primary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    Go Home
                </a>
                <a asp-controller="Donor" asp-action="Index" class="btn-cta-secondary">
                    Browse Donors
                </a>
            </div>

            @if (Model?.ShowRequestId == true && !string.IsNullOrEmpty(Model.RequestId))
            {
                <div class="error-request-id">
                    <span class="error-request-label">Reference ID</span>
                    <code>@Model.RequestId</code>
                </div>
            }
        </div>
    </div>
</section>