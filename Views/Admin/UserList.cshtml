@model List<BloodConnect.Models.UserWithRoleViewModel>

@{
    ViewData["Title"] = "Manage Users";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var currentIsSuperAdmin = User.IsInRole("SuperAdmin");
}

<section class="admin-header py-4 mb-4">
    <div class="container">
        <span class="badge bg-danger mb-2">🛡️ ADMIN PANEL</span>
        <h1 class="h3 fw-bold mb-1">Manage Users</h1>
        <p class="text-muted mb-0 small">Ban abusers, manage roles, delete accounts</p>
    </div>
</section>

<div class="container pb-5">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Email</th>
                        <th>Full Name</th>
                        <th>Roles</th>
                        <th>Joined</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var isSelf = user.Id == currentUserId;
                        var targetIsSuperAdmin = user.Roles.Contains("SuperAdmin");
                        var targetIsAdmin = user.Roles.Contains("Admin") && !targetIsSuperAdmin;

                        // Display role preference: SuperAdmin > Admin > User
                        var displayRole = targetIsSuperAdmin ? "SuperAdmin"
                                        : targetIsAdmin ? "Admin"
                                        : "User";

                        // Rules:
                        // - Self: no buttons
                        // - SuperAdmin target: no buttons (protected)
                        // - Admin target: only SuperAdmin can manage (demote/ban/delete)
                        // - User target: both Admin and SuperAdmin can manage
                        var canTouchTarget = !isSelf
                                            && !targetIsSuperAdmin
                                            && (!targetIsAdmin || currentIsSuperAdmin);

                        <tr>
                            <td class="fw-semibold">
                                @user.Email
                                @if (isSelf)
                                {
                                    <span class="badge bg-info text-dark ms-1">You</span>
                                }
                            </td>
                            <td>@user.FullName</td>
                            <td>
                                <span class="badge bg-@(displayRole == "SuperAdmin" ? "dark" :
                                                         displayRole == "Admin" ? "danger" :
                                                         "secondary")">
                                    @displayRole
                                </span>
                            </td>
                            <td class="text-muted small">
                                @user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                            </td>
                            <td>
                                @if (user.IsBanned)
                                {
                                    <span class="badge bg-danger">Banned</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (isSelf)
                                {
                                    <span class="text-muted small fst-italic">— (current session)</span>
                                }
                                else if (targetIsSuperAdmin)
                                {
                                    <span class="text-muted small fst-italic">— (protected)</span>
                                }
                                else if (!canTouchTarget)
                                {
                                    <span class="text-muted small fst-italic">— (superadmin only)</span>
                                }
                                else
                                {
                                    @* Role toggle *@
                                    @if (targetIsAdmin)
                                    {
                                        @* Only SuperAdmin can demote *@
                                        <form asp-action="DemoteFromAdmin" asp-route-id="@user.Id"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Remove Admin role from @user.Email?');">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                Remove Admin
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="PromoteToAdmin" asp-route-id="@user.Id"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Make @user.Email an Admin?');">
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Make Admin
                                            </button>
                                        </form>
                                    }

                                    @* Ban toggle *@
                                    <form asp-action="ToggleBan" asp-route-id="@user.Id"
                                          method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            @(user.IsBanned ? "Unban" : "Ban")
                                        </button>
                                    </form>

                                    @* Delete *@
                                    <form asp-action="DeleteUser" asp-route-id="@user.Id"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Delete @user.Email?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>