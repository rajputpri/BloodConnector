@model List<BloodConnect.Models.BloodRequest>

@{
    ViewData["Title"] = "Manage Requests";
}

<section class="admin-header py-4 mb-4">
    <div class="container">
        <span class="badge bg-danger mb-2">🛡️ ADMIN PANEL</span>
        <h1 class="h3 fw-bold mb-1">Manage Blood Requests</h1>
        <p class="text-muted mb-0 small">Delete spam or duplicate requests</p>
    </div>
</section>

<div class="container pb-5">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Requester</th>
                        <th>Posted By</th>
                        <th>Blood Group</th>
                        <th>Location</th>
                        <th>Urgency</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model)
                    {
                        <tr>
                            <td class="text-muted">@req.RequestId</td>
                            <td class="fw-semibold">@req.RequesterName</td>
                            <td class="text-muted small">
                                @if (req.User != null)
                                {
                                    <span title="@req.User.Email">@req.User.Email</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Guest</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-danger-subtle text-danger">@req.BloodGroupNeeded</span>
                            </td>
                            <td>@req.Location</td>
                            <td>
                                <span class="badge bg-@(req.UrgencyLevel switch {
                                    "Critical" => "danger",
                                    "High"     => "warning text-dark",
                                    "Medium"   => "info text-dark",
                                    _          => "secondary"
                                })">@req.UrgencyLevel</span>
                            </td>
                            <td>
                                <span class="badge bg-@(req.Status == "Open" ? "primary" : "success")">
                                    @req.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <form asp-action="DeleteRequest" asp-route-id="@req.RequestId"
                                      method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Delete this request?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>