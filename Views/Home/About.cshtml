@{
    ViewData["Title"] = "About Us";
    var totalDonors = (int)(ViewBag.TotalDonors ?? 0);
    var fulfilled = (int)(ViewBag.FulfilledRequests ?? 0);
    var livesTouched = (int)(ViewBag.LivesTouched ?? 0);
    var totalUsers = (int)(ViewBag.TotalUsers ?? 0);
}

<link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />

<div class="pulse-page">

    <!-- ==================== HERO ==================== -->
    <section class="pulse-hero">
        <canvas class="pulse-hero-canvas" id="heroCanvas"></canvas>

        <svg class="pulse-hero-ekg" viewBox="0 0 1440 140" preserveAspectRatio="none">
            <path d="M0,70 L240,70 L260,70 L280,48 L300,92 L320,28 L345,112 L370,14 L395,70 L700,70 L720,70 L740,50 L760,90 L780,30 L805,110 L830,16 L855,70 L1160,70 L1180,70 L1200,48 L1220,92 L1240,28 L1265,112 L1290,14 L1315,70 L1440,70" />
        </svg>

        <div class="pulse-hero-inner">
            <div class="pulse-hero-hud">
                <span class="pulse-hero-hud-dot"></span>
                <span class="pulse-hero-hud-label">Live Network</span>
                <span class="pulse-hero-hud-divider"></span>
                <span class="pulse-hero-hud-label">BPM</span>
                <span class="pulse-hero-hud-value" id="bpmValue">072 · SINUS RHYTHM</span>
            </div>

            <h1 class="pulse-hero-title">
                <span class="pulse-line pulse-line-1">
                    <span class="pulse-word">Every</span>
                    <span class="pulse-word">second,</span>
                    <span class="pulse-word">someone</span>
                </span>
                <span class="pulse-line pulse-line-2">
                    <span class="pulse-word">somewhere</span>
                    <span class="pulse-word">needs</span>
                    <span class="pulse-word accent">blood.</span>
                </span>
                <span class="pulse-line pulse-line-3">
                    <span class="pulse-word">We</span>
                    <span class="pulse-word">answer.</span>
                </span>
            </h1>

            <p class="pulse-hero-sub">
                BloodConnect is a free, real-time, verified blood donation network — connecting
                donors with patients in their most urgent moments. <strong>No middlemen. No fees. No delays.</strong>
            </p>

            <div class="pulse-hero-actions">
                <a asp-controller="Donor" asp-action="Create" class="pulse-btn pulse-btn-primary">
                    Become a Donor
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                <a asp-controller="Home" asp-action="Contact" class="pulse-btn pulse-btn-ghost">
                    Get in Touch
                </a>
            </div>
        </div>

        <div class="pulse-scroll-cue">
            <span>Scroll</span>
            <div class="pulse-scroll-cue-line"></div>
        </div>
    </section>

    <!-- ==================== DIVIDER (replaces marquee) ==================== -->
    <div class="pulse-divider" aria-hidden="true">
        <svg class="pulse-divider-ekg" viewBox="0 0 1440 90" preserveAspectRatio="none">
            <path d="M0,45 L240,45 L260,45 L280,30 L300,60 L320,18 L345,72 L370,10 L395,45 L700,45 L720,45 L740,30 L760,60 L780,18 L805,72 L830,10 L855,45 L1160,45 L1180,45 L1200,30 L1220,60 L1240,18 L1265,72 L1290,10 L1315,45 L1440,45" />
        </svg>
        <span class="pulse-divider-label">Every Drop · Every Life</span>
    </div>

    <!-- ==================== MANIFESTO ==================== -->
    <section class="pulse-manifesto">
        <div class="pulse-manifesto-inner">
            <span class="pulse-eyebrow pulse-reveal">Our Mission</span>
            <h2 class="pulse-manifesto-title pulse-reveal">
                Blood doesn't wait.<br />
                Neither should <em>finding it.</em>
            </h2>

            <div class="pulse-statements">
                <div class="pulse-statement">
                    <span class="pulse-statement-num">01</span>
                    <p class="pulse-statement-text">
                        Every second wasted searching for a donor is a second the patient
                        can't afford. <em>We built this to fix that.</em>
                    </p>
                </div>
                <div class="pulse-statement">
                    <span class="pulse-statement-num">02</span>
                    <p class="pulse-statement-text">
                        Not a directory. Not a WhatsApp group. A <em>real-time network</em>
                        where donors pledge and patients confirm — every match transparent.
                    </p>
                </div>
                <div class="pulse-statement">
                    <span class="pulse-statement-num">03</span>
                    <p class="pulse-statement-text">
                        Free, forever. No premium tier. No data selling. No ads.
                        Because <em>blood isn't a business.</em>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== PROBLEM ==================== -->
    <section class="pulse-problem">
        <div class="pulse-container">
            <div class="pulse-problem-head pulse-reveal">
                <span class="pulse-eyebrow">The Problem</span>
                <h2 class="pulse-h2">Why blood donation needs <em>a better system.</em></h2>
                <p class="pulse-lead">
                    Every day, thousands of patients in India struggle to find compatible donors in time.
                </p>
            </div>

            <div class="pulse-problem-grid">
                <div class="tilt-card pulse-reveal" data-delay="1">
                    <span class="tilt-card-num">01 / TIME</span>
                    <div class="tilt-card-inner">
                        <div class="tilt-card-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <h3>Time is critical</h3>
                        <p>
                            In emergencies, every minute counts. Scattered phone calls and
                            WhatsApp messages waste precious hours that could be saved by one search.
                        </p>
                    </div>
                </div>

                <div class="tilt-card pulse-reveal" data-delay="2">
                    <span class="tilt-card-num">02 / TRUST</span>
                    <div class="tilt-card-inner">
                        <div class="tilt-card-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        </div>
                        <h3>No trust, no verification</h3>
                        <p>
                            Unverified groups and random contacts mean fake promises and wasted
                            time. There's no way to know if a donor will actually show up.
                        </p>
                    </div>
                </div>

                <div class="tilt-card pulse-reveal" data-delay="3">
                    <span class="tilt-card-num">03 / MATCH</span>
                    <div class="tilt-card-inner">
                        <div class="tilt-card-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                        <h3>Wrong blood matching</h3>
                        <p>
                            Not everyone knows compatibility rules. O− is the universal donor,
                            AB+ the universal receiver — but most people don't know who can give to whom.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== IMPACT SIMULATOR ⭐ NEW ==================== -->
