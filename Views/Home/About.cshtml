                        <div class="simulator-output-value" id="simLives">0</div>
                        <div class="simulator-output-label">Lives Saved</div>
                    </div>
                    <div class="simulator-output">
                        <div class="simulator-output-value"><span id="simBlood">0</span><small>ML</small></div>
                        <div class="simulator-output-label">Blood Collected</div>
                    </div>
                    <div class="simulator-output">
                        <div class="simulator-output-value" id="simGroups">0</div>
                        <div class="simulator-output-label">Blood Groups Helped</div>
                    </div>
                    <div class="simulator-output">
                        <div class="simulator-output-value" id="simPatients">0</div>
