</div>

<script>
    (function () {
        'use strict';

        // ============================================================
        // 1. SCROLL REVEAL
        // ============================================================
        const reveals = document.querySelectorAll('.pulse-reveal, .pulse-statement');
        const revealIO = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    e.target.classList.add('is-in');
                    revealIO.unobserve(e.target);
                }
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -70px 0px' });
        reveals.forEach(el => revealIO.observe(el));

        // ============================================================
        // 2. COUNTERS (numbers section)
        // ============================================================
        const counters = document.querySelectorAll('[data-count]');
        const counterIO = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                if (!e.isIntersecting) return;
                const el = e.target;
                const target = parseInt(el.dataset.count, 10) || 0;
                const duration = 1800;
                const start = performance.now();
                const tick = (now) => {
                    const p = Math.min((now - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - p, 4);
                    el.textContent = Math.round(target * eased);
                    if (p < 1) requestAnimationFrame(tick);
                    else el.textContent = target;
                };
                requestAnimationFrame(tick);
                counterIO.unobserve(el);
            });
        }, { threshold: 0.5 });
        counters.forEach(el => counterIO.observe(el));

        // ============================================================
        // 3. HERO CANVAS — Blood rain
        // ============================================================
        const canvas = document.getElementById('heroCanvas');
        if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            const ctx = canvas.getContext('2d');
            let W = 0, H = 0, drops = [];

            function resize() {
                const dpr = Math.min(window.devicePixelRatio || 1, 2);
                W = canvas.offsetWidth;
                H = canvas.offsetHeight;
                canvas.width = W * dpr;
                canvas.height = H * dpr;
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            }
            resize();
            window.addEventListener('resize', resize);

            function makeDrop(reset) {
                return {
                    x: Math.random() * W,
                    y: reset ? -20 - Math.random() * 100 : Math.random() * H,
                    vy: 0.6 + Math.random() * 1.6,
                    r: 1.5 + Math.random() * 3.5,
                    alpha: 0.25 + Math.random() * 0.5,
                    wobble: Math.random() * Math.PI * 2,
                    wobbleSpeed: 0.012 + Math.random() * 0.02
                };
            }
            for (let i = 0; i < 40; i++) drops.push(makeDrop(false));

            function draw() {
                ctx.clearRect(0, 0, W, H);
                for (let i = 0; i < drops.length; i++) {
                    const d = drops[i];
                    d.wobble += d.wobbleSpeed;
                    d.y += d.vy;
                    d.x += Math.sin(d.wobble) * 0.4;

                    const grd = ctx.createRadialGradient(d.x, d.y, 0, d.x, d.y, d.r * 6);
                    grd.addColorStop(0, `rgba(239, 68, 68, ${d.alpha})`);
                    grd.addColorStop(0.4, `rgba(220, 38, 38, ${d.alpha * 0.5})`);
                    grd.addColorStop(1, 'rgba(220, 38, 38, 0)');
                    ctx.fillStyle = grd;
                    ctx.beginPath();
                    ctx.arc(d.x, d.y, d.r * 6, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.fillStyle = `rgba(248, 113, 113, ${d.alpha + 0.25})`;
                    ctx.beginPath();
                    ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.strokeStyle = `rgba(220, 38, 38, ${d.alpha * 0.35})`;
                    ctx.lineWidth = d.r * 0.6;
                    ctx.beginPath();
                    ctx.moveTo(d.x, d.y);
                    ctx.lineTo(d.x, d.y - d.r * 5);
                    ctx.stroke();

                    if (d.y > H + 30) drops[i] = makeDrop(true);
                }
                requestAnimationFrame(draw);
            }
            draw();
        }

        // ============================================================
        // 4. HERO BPM
        // ============================================================
        const bpmEl = document.getElementById('bpmValue');
        if (bpmEl) {
            let bpm = 72;
            let dir = 1;
            const rhythms = ['SINUS RHYTHM', 'SINUS RHYTHM', 'NORMAL', 'STABLE'];
            let rhythmIdx = 0;

            setInterval(() => {
                bpm += dir * (Math.random() < 0.5 ? 1 : 2);
                if (bpm >= 88) dir = -1;
                if (bpm <= 66) dir = 1;
                if (Math.random() < 0.2) rhythmIdx = (rhythmIdx + 1) % rhythms.length;
                const padded = String(bpm).padStart(3, '0');
                bpmEl.textContent = `${padded} · ${rhythms[rhythmIdx]}`;
            }, 1600);
        }

        // ============================================================
        // 5. 3D TILT
        // ============================================================
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
            window.matchMedia('(hover: hover)').matches) {
            document.querySelectorAll('.tilt-card').forEach(card => {
                card.addEventListener('mousemove', (e) => {
                    const r = card.getBoundingClientRect();
                    const x = e.clientX - r.left;
                    const y = e.clientY - r.top;
                    const cx = r.width / 2, cy = r.height / 2;
                    const rotY = ((x - cx) / cx) * 8;
                    const rotX = -((y - cy) / cy) * 8;

                    card.style.setProperty('--mx', `${x}px`);
                    card.style.setProperty('--my', `${y}px`);
                    card.style.transform = `perspective(1000px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-4px)`;
                });
                card.addEventListener('mouseleave', () => {
                    card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(0)';
                });
            });
        }

        // ============================================================
        // 6. IMPACT SIMULATOR
        // ============================================================
        const simRange = document.getElementById('simRange');
        if (simRange) {
            const elDonations = document.getElementById('simDonations');
            const elLives = document.getElementById('simLives');
            const elBlood = document.getElementById('simBlood');
            const elGroups = document.getElementById('simGroups');
            const elPatients = document.getElementById('simPatients');

            // Store current displayed values for smooth interpolation
            let displayed = { lives: 0, blood: 0, groups: 0, patients: 0 };
            let target = { lives: 0, blood: 0, groups: 0, patients: 0 };

            function easeOutQuart(t) { return 1 - Math.pow(1 - t, 4); }

            function pulse(el) {
                el.classList.remove('is-pulsing');
                void el.offsetWidth;
                el.classList.add('is-pulsing');
            }

            function updateTargets(donations) {
                // Each donation: saves ~3 lives, 350 mL blood, helps up to 3 patients
                // Groups: mod 8 (only 8 blood groups exist), scaled
                target.lives = donations * 3;
                target.blood = donations * 350;
                target.patients = donations * 2 + Math.floor(donations / 3);
                target.groups = Math.min(8, donations);
            }

            function animateValues() {
                const keys = ['lives', 'blood', 'groups', 'patients'];
                const els = {
                    lives: elLives, blood: elBlood, groups: elGroups, patients: elPatients
                };
                let changed = false;
                keys.forEach(k => {
                    const diff = target[k] - displayed[k];
                    if (Math.abs(diff) > 0.5) {
                        displayed[k] += diff * 0.15;
                        els[k].textContent = Math.round(displayed[k]);
                        changed = true;
                    } else if (displayed[k] !== target[k]) {
                        displayed[k] = target[k];
                        els[k].textContent = target[k];
                        changed = true;
                    }
                });
                if (changed) requestAnimationFrame(animateValues);
            }

            function handleSlider() {
                const val = parseInt(simRange.value, 10);
                const pct = ((val - simRange.min) / (simRange.max - simRange.min)) * 100;
                simRange.style.setProperty('--val', pct + '%');

                elDonations.textContent = val;
                updateTargets(val);

                pulse(elLives);
                pulse(elBlood);
                pulse(elGroups);
                pulse(elPatients);

                requestAnimationFrame(animateValues);
            }

            simRange.addEventListener('input', handleSlider);
            // initial
            handleSlider();
        }

        // ============================================================
        // 7. BLOOD COMPATIBILITY
        // ============================================================
        const compatMatrix = {
            'O-':  ['O-'],
            'O+':  ['O-', 'O+'],
            'A-':  ['O-', 'A-'],
            'A+':  ['O-', 'O+', 'A-', 'A+'],
            'B-':  ['O-', 'B-'],
            'B+':  ['O-', 'O+', 'B-', 'B+'],
            'AB-': ['O-', 'A-', 'B-', 'AB-'],
            'AB+': ['O-', 'O+', 'A-', 'A+', 'B-', 'B+', 'AB-', 'AB+']
        };

        const cells = document.querySelectorAll('.pulse-blood-cell');
        const compatSvg = document.getElementById('compatSvg');
        const compatResult = document.getElementById('compatResult');
        const compatCanvas = document.getElementById('compatCanvas');

        const norm = g => g.replace('−', '-');
        const pretty = g => g.replace('-', '−');

        function clearCompat() {
            cells.forEach(c => c.classList.remove('is-active', 'is-receiver', 'is-donor', 'is-dim'));
            compatSvg.innerHTML = '';
            compatResult.classList.remove('is-in');
        }

        cells.forEach(cell => {
            cell.addEventListener('click', () => {
                const group = norm(cell.dataset.group);
                const donors = compatMatrix[group] || [];
                const receivers = Object.keys(compatMatrix).filter(r => compatMatrix[r].includes(group));

                clearCompat();
                cell.classList.add('is-active');

                cells.forEach(c => {
                    const g = norm(c.dataset.group);
                    if (g === group) return;
                    if (donors.includes(g)) c.classList.add('is-receiver');
                    else if (receivers.includes(g)) c.classList.add('is-donor');
                    else c.classList.add('is-dim');
                });

                const canvasRect = compatCanvas.getBoundingClientRect();
                const activeRect = cell.getBoundingClientRect();
                const ax = activeRect.left + activeRect.width / 2 - canvasRect.left;
                const ay = activeRect.top + activeRect.height / 2 - canvasRect.top;

                compatSvg.setAttribute('viewBox', `0 0 ${canvasRect.width} ${canvasRect.height}`);

                cells.forEach(c => {
                    const g = norm(c.dataset.group);
                    if (g === group) return;
                    if (!donors.includes(g) && !receivers.includes(g)) return;

                    const r = c.getBoundingClientRect();
                    const bx = r.left + r.width / 2 - canvasRect.left;
                    const by = r.top + r.height / 2 - canvasRect.top;

                    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                    line.setAttribute('x1', ax);
                    line.setAttribute('y1', ay);
                    line.setAttribute('x2', bx);
                    line.setAttribute('y2', by);
                    line.setAttribute('stroke', donors.includes(g) ? '#EF4444' : '#D4A24C');
                    line.setAttribute('stroke-dasharray', '500');
                    line.setAttribute('stroke-dashoffset', '500');
                    line.setAttribute('opacity', '0.85');
                    compatSvg.appendChild(line);
                    requestAnimationFrame(() => line.classList.add('is-visible'));
                });

                const donorsText = donors.map(pretty).join(', ');
                let extra = '';
                if (group === 'O-') extra = ' · <span class="gold">Universal Donor</span>';
                if (group === 'AB+') extra = ' · <span class="gold">Universal Receiver</span>';

                compatResult.innerHTML =
                    `<strong>${pretty(group)}</strong> can receive from ${donors.length} group${donors.length > 1 ? 's' : ''}: <strong>${donorsText}</strong>${extra}`;
                compatResult.classList.add('is-in');
            });
        });

        let autoCompat = false;
        const compatIO = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                if (e.isIntersecting && !autoCompat) {
                    autoCompat = true;
                    setTimeout(() => {
                        const f = document.querySelector('.pulse-blood-cell[data-group="O-"]');
                        if (f) f.click();
                    }, 600);
                }
            });
        }, { threshold: 0.5 });
        if (compatCanvas) compatIO.observe(compatCanvas);

        // ============================================================
        // 8. BLOOD CELL EXPLORER
        // ============================================================
        const explorerData = {
            lifespan: {
                value: '120',
                unit: 'days lifespan',
                badge: 'Lifespan',
                title: 'Red blood cells live for about <em>120 days</em>.',
                body: 'Your body constantly replaces old cells with new ones. That\'s why a single donation never puts you at risk — your body rebuilds the lost blood in weeks, not months. Donating regularly is safe, healthy, and saves lives.',
                stat1v: '120', stat1l: 'Days of life',
                stat2v: '2M+', stat2l: 'Cells per second'
            },
            volume: {
                value: '5',
                unit: 'liters total',
                badge: 'Blood Volume',
                title: 'An average adult carries <em>4.5 to 5.5 liters</em> of blood.',
                body: 'That\'s roughly 7-8% of your entire body weight. Only about 350 mL is taken during a single donation — under 10% of your total volume. Your body replaces the plasma within 24 hours and the red cells within a few weeks.',
                stat1v: '5L', stat1l: 'Total volume',
                stat2v: '7-8%', stat2l: 'Of body weight'
            },
            donation: {
                value: '350',
                unit: 'ml per donation',
                badge: 'Per Donation',
                title: 'One donation is only <em>350 mL</em> — a small sip.',
                body: 'A typical blood donation takes 8-10 minutes to collect. The whole process, including screening and rest, takes under an hour. In that hour, you could save up to three people.',
                stat1v: '8-10', stat1l: 'Minutes to collect',
                stat2v: '< 1 hr', stat2l: 'Total time'
            },
            impact: {
                value: '3',
                unit: 'lives saved',
                badge: 'Impact',
                title: 'One donation. <em>Three lives.</em>',
                body: 'Blood can be separated into red cells, plasma, and platelets — three components, each going to a different patient. A single donation can help a surgery patient, a cancer fighter, and a newborn — all in one day.',
                stat1v: '3', stat1l: 'Lives per donation',
                stat2v: '1', stat2l: 'Donation needed'
            }
        };

        const explorerValue = document.getElementById('explorerValue');
        const explorerUnit = document.getElementById('explorerUnit');
        const explorerBadge = document.getElementById('explorerBadge');
        const explorerTitle = document.getElementById('explorerTitle');
        const explorerBody = document.getElementById('explorerBody');
        const hotspots = document.querySelectorAll('.explorer-hotspot');

        let stats1v = document.querySelector('.explorer-info-stat:nth-child(1) .explorer-info-stat-value');
        let stats1l = document.querySelector('.explorer-info-stat:nth-child(1) .explorer-info-stat-label');
        let stats2v = document.querySelector('.explorer-info-stat:nth-child(2) .explorer-info-stat-value');
        let stats2l = document.querySelector('.explorer-info-stat:nth-child(2) .explorer-info-stat-label');

        function animateNumber(el, target) {
            const start = parseInt(el.textContent, 10) || 0;
            const isNumeric = !isNaN(start) && !isNaN(parseInt(target, 10));
            if (!isNumeric) { el.textContent = target; return; }
            const end = parseInt(target, 10);
            const dur = 500;
            const t0 = performance.now();
            const tick = (now) => {
                const p = Math.min((now - t0) / dur, 1);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(start + (end - start) * eased);
                if (p < 1) requestAnimationFrame(tick);
                else el.textContent = target;
            };
            requestAnimationFrame(tick);
        }

        hotspots.forEach(h => {
            h.addEventListener('click', () => {
                const key = h.dataset.key;
                const d = explorerData[key];
                if (!d) return;

                hotspots.forEach(x => x.classList.remove('is-active'));
                h.classList.add('is-active');

                // Fade-out-in effect
                [explorerValue, explorerUnit, explorerBadge, explorerTitle, explorerBody].forEach(el => {
                    el.style.opacity = '0';
                    el.style.transform = 'translateY(6px)';
                });

                setTimeout(() => {
                    explorerValue.textContent = d.value;
                    explorerUnit.textContent = d.unit;
                    explorerBadge.textContent = d.badge;
                    explorerTitle.innerHTML = d.title;
                    explorerBody.textContent = d.body;
                    if (stats1v) stats1v.textContent = d.stat1v;
                    if (stats1l) stats1l.textContent = d.stat1l;
                    if (stats2v) stats2v.textContent = d.stat2v;
                    if (stats2l) stats2l.textContent = d.stat2l;

                    [explorerValue, explorerUnit, explorerBadge, explorerTitle, explorerBody].forEach(el => {
                        el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                        el.style.opacity = '1';
                        el.style.transform = 'translateY(0)';
                    });
                }, 200);
            });
        });

        // ============================================================
        // 9. TIMELINE DRAG
        // ============================================================
        const timeline = document.getElementById('timelineTrack');
        if (timeline) {
            let isDown = false, startX = 0, scrollStart = 0;
            timeline.addEventListener('mousedown', (e) => {
                isDown = true;
                timeline.classList.add('is-dragging');
                startX = e.pageX - timeline.offsetLeft;
                scrollStart = timeline.scrollLeft;
            });
            ['mouseleave', 'mouseup'].forEach(evt =>
                timeline.addEventListener(evt, () => {
                    isDown = false;
                    timeline.classList.remove('is-dragging');
                })
            );
            timeline.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                e.preventDefault();
                const walk = (e.pageX - timeline.offsetLeft - startX) * 1.4;
                timeline.scrollLeft = scrollStart - walk;
            });
            timeline.addEventListener('wheel', (e) => {
                if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                    e.preventDefault();
                    timeline.scrollLeft += e.deltaY;
                }
            }, { passive: false });
        }

        // ============================================================
        // 10. HERO PARALLAX
        // ============================================================
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
            window.matchMedia('(min-width: 1024px)').matches) {
            const heroContent = document.querySelector('.pulse-hero-inner');
            let raf = null;
            window.addEventListener('scroll', () => {
                if (raf) return;
                raf = requestAnimationFrame(() => {
                    const y = window.scrollY;
                    if (y < 800 && heroContent) {
                        heroContent.style.transform = `translateY(${y * 0.15}px)`;
                        heroContent.style.opacity = String(Math.max(0, 1 - y / 900));
                    }
                    raf = null;
                });
            }, { passive: true });
        }

    })();
</script>