<!-- EMBEDDED THREEJS 3D SCENE VIA CUSTOM ELEMENT REQUIREMENT -->
<div class="relative w-full h-[480px] lg:h-[580px] rounded-3xl overflow-hidden glass-editorial border border-white/10 shadow-2xl" id="threejs-bio-centerpiece">
<!-- Embedding exact custom tag as instructed -->
<!-- STITCH_THREEJS_START:ANIMATION_11 class="w-full h-full absolute inset-0 pointer-events-auto" -->
<div class="w-full h-full absolute inset-0 pointer-events-auto" style="display:block;">
<script src="https://ajax.googleapis.com/ajax/libs/threejs/r125/three.min.js"></script>
<div id="threejs-container-ANIMATION_11" style="width:100%;height:100%"></div>
<script>
(function() {
  const container = document.getElementById('threejs-container-ANIMATION_11');
  const devicePixelRatio = window.devicePixelRatio || 1;
  // BloodConnect Signature Biomorphic Erythrocyte & Hemodynamic Fluid WebGL Scene
const container = document.getElementById('threejs-bio-centerpiece') || document.body;
const width = container.clientWidth || window.innerWidth;
const height = container.clientHeight || window.innerHeight;

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
camera.position.set(0, 0, 8.5);

const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: "high-performance" });
renderer.setSize(width, height);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.25;
container.appendChild(renderer.domElement);

// Organic Biconcave Erythrocyte Geometry Synthesis
function createBiconcaveErythrocyte(radius = 1.6, thickness = 0.55, segments = 64) {
    const geom = new THREE.SphereGeometry(radius, segments, segments);
    const pos = geom.attributes.position;
    for (let i = 0; i < pos.count; i++) {
        let x = pos.getX(i);
        let y = pos.getY(i);
        let z = pos.getZ(i);
        let r = Math.sqrt(x * x + y * y);
        let normR = r / radius;
        // Biconcave erythrocyte deformation formula: depressed center, swollen torus rim
        let dimple = 0.35 + 1.2 * (normR * normR) - 0.7 * (normR * normR * normR * normR);
        pos.setZ(i, z * dimple * thickness);
    }
    geom.computeVertexNormals();
    return geom;
}

const cellGroup = new THREE.Group();
scene.add(cellGroup);

// Premium Translucent Biological Shader Material
const cellMaterial = new THREE.MeshPhysicalMaterial({
    color: new THREE.Color(0xd90429),
    emissive: new THREE.Color(0x38040e),
    roughness: 0.15,
    metalness: 0.05,
    transmission: 0.65,
    ior: 1.38,
    thickness: 1.2,
    specularColor: new THREE.Color(0xff758f),
    specularIntensity: 1.0,
    clearcoat: 0.9,
    clearcoatRoughness: 0.1
});

// Central Primary Erythrocyte
const mainCellGeom = createBiconcaveErythrocyte(1.75, 0.65, 80);
const mainCell = new THREE.Mesh(mainCellGeom, cellMaterial);
cellGroup.add(mainCell);

// Peripheral Floating Capillary Micro-Erythrocytes
const satelliteCells = [];
for (let i = 0; i < 7; i++) {
    const scale = 0.28 + Math.random() * 0.38;
    const geom = createBiconcaveErythrocyte(1.2, 0.55, 36);
    const mat = cellMaterial.clone();
    mat.transmission = 0.75;
    mat.color = new THREE.Color(i % 2 === 0 ? 0xef233c : 0xb5179e);
    const mesh = new THREE.Mesh(geom, mat);
    
    const angle = (i / 7) * Math.PI * 2;
    const dist = 3.2 + Math.random() * 1.6;
    mesh.position.set(Math.cos(angle) * dist, Math.sin(angle) * dist * 0.75, (Math.random() - 0.5) * 2.5);
    mesh.scale.set(scale, scale, scale);
    mesh.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
    
    cellGroup.add(mesh);
    satelliteCells.push({
        mesh,
        basePos: mesh.position.clone(),
        speed: 0.5 + Math.random() * 0.8,
        orbitRadius: dist,
        phase: Math.random() * Math.PI * 2,
        rotSpeed: { x: (Math.random() - 0.5) * 0.02, y: (Math.random() - 0.5) * 0.02, z: (Math.random() - 0.5) * 0.02 }
    });
}

// Hemodynamic Flow Particle Stream (Arterial Plasma Nanospheres)
const particleCount = 280;
const pGeo = new THREE.BufferGeometry();
const pPos = new Float32Array(particleCount * 3);
const pSizes = new Float32Array(particleCount);
const pColors = new Float32Array(particleCount * 3);

for (let i = 0; i < particleCount; i++) {
    const i3 = i * 3;
    const t = (i / particleCount) * Math.PI * 4;
    pPos[i3] = (Math.sin(t * 1.5) + (Math.random() - 0.5) * 0.8) * 4.2;
    pPos[i3 + 1] = (Math.cos(t * 0.8) + (Math.random() - 0.5) * 0.8) * 3.2;
    pPos[i3 + 2] = (Math.sin(t * 2.2) + (Math.random() - 0.5) * 1.5) * 2.5;
    
    pSizes[i] = 0.04 + Math.random() * 0.08;
    
    if (i % 3 === 0) {
        pColors[i3] = 1.0; pColors[i3+1] = 0.9; pColors[i3+2] = 0.85; // champagne glowing platelets
    } else {
        pColors[i3] = 0.95; pColors[i3+1] = 0.12; pColors[i3+2] = 0.25; // arterial red
    }
}
pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
pGeo.setAttribute('size', new THREE.BufferAttribute(pSizes, 1));

const pMat = new THREE.PointsMaterial({
    size: 0.09,
    vertexColors: false,
    color: 0xff3b5c,
    transparent: true,
    opacity: 0.75,
    blending: THREE.AdditiveBlending
});
const particles = new THREE.Points(pGeo, pMat);
scene.add(particles);

// Studio Biomorphic Lighting Rig
const ambientLight = new THREE.AmbientLight(0x1a060d, 2.5);
scene.add(ambientLight);

const mainRimLight = new THREE.DirectionalLight(0xff2a55, 4.8);
mainRimLight.position.set(4, 5, 4);
scene.add(mainRimLight);

const arterialBackLight = new THREE.PointLight(0xff0040, 5.0, 15);
arterialBackLight.position.set(-4, -2, -3);
scene.add(arterialBackLight);

const softWarmFill = new THREE.DirectionalLight(0xfdf0d5, 1.8);
softWarmFill.position.set(-3, 4, 3);
scene.add(softWarmFill);

// Interactive Cursor Tracking Vector
const mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
window.addEventListener('mousemove', (e) => {
    mouse.targetX = (e.clientX / window.innerWidth) * 2 - 1;
    mouse.targetY = -(e.clientY / window.innerHeight) * 2 + 1;
});

// Animation Loop with Cardiac Diastole / Systole Rhythm
let clock = new THREE.Clock();
function animate() {
    requestAnimationFrame(animate);
    const elapsedTime = clock.getElapsedTime();

    // Smooth cursor interpolation
    mouse.x += (mouse.targetX - mouse.x) * 0.05;
    mouse.y += (mouse.targetY - mouse.y) * 0.05;

    // Cardiac Systolic contraction & Diastolic expansion wave (72 bpm simulation)
    const bpmFreq = (72 / 60) * Math.PI * 2;
    const pulseHeartbeat = Math.pow(Math.sin(elapsedTime * bpmFreq), 12) * 0.12 + Math.sin(elapsedTime * bpmFreq * 0.5) * 0.03;
    const currentScale = 1.0 + pulseHeartbeat;
    mainCell.scale.set(currentScale, currentScale, currentScale);

    // Continuous elegant organic rotation + mouse tilt
    mainCell.rotation.x = Math.sin(elapsedTime * 0.4) * 0.35 + mouse.y * 0.65;
    mainCell.rotation.y = elapsedTime * 0.35 + mouse.x * 0.75;
    mainCell.rotation.z = Math.cos(elapsedTime * 0.3) * 0.2;

    // Orbiting satellite cells
    satelliteCells.forEach((sat, idx) => {
        const t = elapsedTime * sat.speed + sat.phase;
        sat.mesh.position.x = sat.basePos.x + Math.sin(t) * 0.45;
        sat.mesh.position.y = sat.basePos.y + Math.cos(t * 1.2) * 0.35;
        sat.mesh.position.z = sat.basePos.z + Math.sin(t * 0.8) * 0.5;
        sat.mesh.rotation.x += sat.rotSpeed.x;
        sat.mesh.rotation.y += sat.rotSpeed.y;
    });

    // Particle flow stream animation
    const positions = pGeo.attributes.position.array;
    for (let i = 0; i < particleCount; i++) {
        let i3 = i * 3;
        positions[i3 + 1] += 0.012; // slow rising bloodstream
        if (positions[i3 + 1] > 4.5) positions[i3 + 1] = -4.5;
        positions[i3] += Math.sin(elapsedTime + i) * 0.003;
    }
    pGeo.attributes.position.needsUpdate = true;
    particles.rotation.y = elapsedTime * 0.08;

    cellGroup.rotation.y = mouse.x * 0.2;
    cellGroup.rotation.x = -mouse.y * 0.2;

    renderer.render(scene, camera);
}
animate();

// Resize listener
window.addEventListener('resize', () => {
    const w = container.clientWidth || window.innerWidth;
    const h = container.clientHeight || window.innerHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
});

})();
</script>
</div>
