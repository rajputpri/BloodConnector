<!-- ======================================================== -->
<!-- PROCEDURAL WEB AUDIO SYNTHESIZER & INTERACTIVITY ENGINE -->
<!-- ======================================================== -->
<script>
  // 1. Procedural Web Audio API Engine
  class BioAudioSynthesizer {
    constructor() {
      this.ctx = null;
      this.enabled = false;
      this.volume = 0.5;
    }

    ensureContext() {
      if (!this.ctx) {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (AudioContext) this.ctx = new AudioContext();
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
    }

    setVolume(val) {
      this.volume = Math.max(0, Math.min(1, parseFloat(val)));
    }

    // A. Experience Activation: Deep Double Heartbeat Pulse
    playCardiacPulse() {
      if (!this.enabled) return;
      this.ensureContext();
      if (!this.ctx) return;
      const t = this.ctx.currentTime;
      // Ventricular Systole (lub)
      this.synthSine(t, 55, 0.14, 0.5 * this.volume);
      // Atrial Snap (dub)
      this.synthSine(t + 0.15, 75, 0.16, 0.38 * this.volume);
      // High harmonic bio-crystalline shimmer
      this.synthTriangle(t + 0.3, 440, 0.2, 0.06 * this.volume);
    }

    // B. CTA Click: Satisfying low-frequency impact with glassy shimmer
    playTacticalClick() {
      if (!this.enabled) return;
      this.ensureContext();
      if (!this.ctx) return;
      const t = this.ctx.currentTime;
      this.synthSine(t, 130, 0.1, 0.45 * this.volume);
      this.synthTriangle(t, 840, 0.08, 0.18 * this.volume);
    }

    // C. Donor Search: Subtle scanning sweep & clean chord
    playRadarSweep() {
      if (!this.enabled) return;
      this.ensureContext();
      if (!this.ctx) return;
      const t = this.ctx.currentTime;
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(320, t);
      osc.frequency.exponentialRampToValueAtTime(960, t + 0.15);
      gain.gain.setValueAtTime(0.3 * this.volume, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.15);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start(t);
      osc.stop(t + 0.15);
    }

    // D. Blood Match Trigger: Rising 3-Note Harmonic Chime
    playMatchChime() {
      if (!this.enabled) return;
      this.ensureContext();
      if (!this.ctx) return;
      const t = this.ctx.currentTime;
      const chord = [523.25, 659.25, 783.99]; // C5, E5, G5
      chord.forEach((freq, idx) => {
        this.synthSine(t + (idx * 0.05), freq, 0.35, 0.2 * this.volume);
      });
    }

    // Triad Engage Chord for Donor Registration
    playEngageChord() {
      if (!this.enabled) return;
      this.ensureContext();
      if (!this.ctx) return;
      const t = this.ctx.currentTime;
      [440, 554.37, 659.25, 880].forEach((freq, idx) => {
        this.synthSine(t + (idx * 0.04), freq, 0.4, 0.18 * this.volume);
      });
    }

    // E. Urgent Distress Notification: Two-tone Medical Ping
    playDistressPing() {
      if (!this.enabled) return;
      this.ensureContext();
      if (!this.ctx) return;
      const t = this.ctx.currentTime;
      this.synthTriangle(t, 880, 0.16, 0.35 * this.volume);
      this.synthTriangle(t + 0.11, 740, 0.25, 0.25 * this.volume);
    }

    synthSine(time, freq, duration, gainVal) {
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, time);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.6, time + duration);
      gain.gain.setValueAtTime(gainVal, time);
      gain.gain.exponentialRampToValueAtTime(0.001, time + duration);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start(time);
      osc.stop(time + duration);
    }

    synthTriangle(time, freq, duration, gainVal) {
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, time);
      gain.gain.setValueAtTime(gainVal, time);
      gain.gain.exponentialRampToValueAtTime(0.001, time + duration);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start(time);
      osc.stop(time + duration);
    }
  }

  const audioEngine = new BioAudioSynthesizer();

  // Floating HUD Controller Listeners
  const audioToggleBtn = document.getElementById('audioToggleBtn');
  const audioStateLabel = document.getElementById('audioStateLabel');
  const audioDot = document.getElementById('audioDot');
  const audioPingRing = document.getElementById('audioPingRing');
  const audioSliderContainer = document.getElementById('audioSliderContainer');
  const audioVolSlider = document.getElementById('audioVolSlider');
  const audioTestBtn = document.getElementById('audioTestBtn');

  audioToggleBtn.addEventListener('click', () => {
    audioEngine.ensureContext();
    audioEngine.enabled = !audioEngine.enabled;

    if (audioEngine.enabled) {
      audioStateLabel.textContent = 'AUDIO: ON';
      audioDot.className = 'relative inline-flex rounded-full h-2 w-2 bg-emerald-bio';
      audioPingRing.classList.remove('hidden');
      audioSliderContainer.classList.remove('hidden');
      audioSliderContainer.classList.add('flex');
      audioEngine.playCardiacPulse();
    } else {
      audioStateLabel.textContent = 'AUDIO: OFF';
      audioDot.className = 'relative inline-flex rounded-full h-2 w-2 bg-slate-500';
      audioPingRing.classList.add('hidden');
      audioSliderContainer.classList.add('hidden');
      audioSliderContainer.classList.remove('flex');
    }
  });

  audioVolSlider.addEventListener('input', (e) => audioEngine.setVolume(e.target.value));
  audioTestBtn.addEventListener('click', () => audioEngine.playCardiacPulse());

  // 2. Search Console Antigen Chip Selector
  const antigenButtons = document.querySelectorAll('.antigen-btn');
  const hiddenBloodGroup = document.getElementById('hiddenBloodGroup');

  antigenButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-val');
      if (hiddenBloodGroup) hiddenBloodGroup.value = val;

      antigenButtons.forEach(b => {
        b.classList.remove('border-2', 'border-arterial-crimson', 'bg-arterial-crimson/25', 'shadow-lg');
        b.classList.add('border-white/10', 'bg-white/5');
      });

      btn.classList.remove('border-white/10', 'bg-white/5');
      btn.classList.add('border-2', 'border-arterial-crimson', 'bg-arterial-crimson/25', 'shadow-lg');
      audioEngine.playRadarSweep();
    });
  });

  function quickPresetLocation(loc) {
    const inp = document.getElementById('locationInput');
    if (inp) {
      inp.value = loc;
      inp.focus();
      audioEngine.playTacticalClick();
    }
  }

  // 3. Immunohematology Matrix Logic
  const antigenMatrixDataset = {
    'O-': {
      name: 'O- NEGATIVE',
      outbound: ['O-', 'O+', 'A-', 'A+', 'B-', 'B+', 'AB-', 'AB+'],
      inbound: ['O-'],
      summary: '<strong>O- Negative</strong> lacks A, B, and Rh antigen markers on the erythrocyte envelope. It can be safely infused into any acute trauma patient before laboratory cross-matching verification.'
    },
    'O+': {
      name: 'O+ POSITIVE',
      outbound: ['O+', 'A+', 'B+', 'AB+'],
      inbound: ['O-', 'O+'],
      summary: '<strong>O+ Positive</strong> possesses the Rh factor. It is the most prevalent blood type across India (38%), safely accepted by all Rh-positive patients.'
    },
    'A-': {
      name: 'A- NEGATIVE',
      outbound: ['A+', 'A-', 'AB+', 'AB-'],
      inbound: ['O-', 'A-'],
      summary: '<strong>A- Negative</strong> carries only A antigens without Rh factors. Compatible with all A and AB recipients.'
    },
    'A+': {
      name: 'A+ POSITIVE',
      outbound: ['A+', 'AB+'],
      inbound: ['O-', 'O+', 'A-', 'A+'],
      summary: '<strong>A+ Positive</strong> is in persistent high clinical demand for therapeutic platelets and emergency packed cell transfusions.'
    },
    'B-': {
      name: 'B- NEGATIVE',
      outbound: ['B+', 'B-', 'AB+', 'AB-'],
      inbound: ['O-', 'B-'],
      summary: '<strong>B- Negative</strong> is an exceptionally critical blood bank reserve with low population prevalence. Donates safely to B and AB patients.'
    },
    'B+': {
      name: 'B+ POSITIVE',
      outbound: ['B+', 'AB+'],
      inbound: ['O-', 'O+', 'B-', 'B+'],
      summary: '<strong>B+ Positive</strong> has a 32% prevalence in South Asia, acting as a foundational blood group across high-volume acute casualty departments.'
    },
    'AB-': {
      name: 'AB- NEGATIVE',
      outbound: ['AB+', 'AB-'],
      inbound: ['O-', 'A-', 'B-', 'AB-'],
      summary: '<strong>AB- Negative</strong> is the rarest major group (<1% globally). Can receive packed red cells from all Rh-negative donors.'
    },
    'AB+': {
      name: 'AB+ POSITIVE',
      outbound: ['AB+'],
      inbound: ['O-', 'O+', 'A-', 'A+', 'B-', 'B+', 'AB-', 'AB+'],
      summary: '<strong>AB+ Positive</strong> is the Universal Red Blood Cell Recipient. Possessing A, B, and Rh antigens, their immune system will not reject red cells from any donor.'
    }
  };

  const matrixNodes = document.querySelectorAll('.matrix-node');
  const diagnosticActiveBadge = document.getElementById('diagnosticActiveBadge');
  const diagnosticOutboundText = document.getElementById('diagnosticOutboundText');
  const diagnosticOutboundBadges = document.getElementById('diagnosticOutboundBadges');
  const diagnosticInboundText = document.getElementById('diagnosticInboundText');
  const diagnosticInboundBadges = document.getElementById('diagnosticInboundBadges');
  const diagnosticSummary = document.getElementById('diagnosticSummary');

  matrixNodes.forEach(node => {
    node.addEventListener('click', () => {
      const type = node.getAttribute('data-type');
      const data = antigenMatrixDataset[type];
      if (!data) return;

      matrixNodes.forEach(n => {
        n.classList.remove('border-2', 'border-arterial-crimson', 'bg-arterial-crimson/20');
        n.classList.add('border-white/10');
      });
      node.classList.remove('border-white/10');
      node.classList.add('border-2', 'border-arterial-crimson', 'bg-arterial-crimson/20');

      diagnosticActiveBadge.textContent = `ACTIVE: ${data.name}`;
      diagnosticOutboundText.textContent = `${data.outbound.length} of 8 TYPES (${type === 'O-' ? 'EVERYONE' : data.outbound.join(', ')})`;
      diagnosticInboundText.textContent = `${data.inbound.length} of 8 TYPES (${data.inbound.join(', ')})`;

      diagnosticOutboundBadges.innerHTML = data.outbound.map(item => 
        `<span class="px-2.5 py-1 rounded-lg bg-emerald-bio/15 text-emerald-bio border border-emerald-bio/40 text-[11px] font-bold">${item}</span>`
      ).join('');

      diagnosticInboundBadges.innerHTML = data.inbound.map(item => 
        `<span class="px-2.5 py-1 rounded-lg bg-arterial-crimson/20 text-arterial-crimson border border-arterial-crimson/50 text-[11px] font-bold">${item}</span>`
      ).join('');

      diagnosticSummary.innerHTML = data.summary;
      audioEngine.playMatchChime();
    });
  });

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileDrawer = document.getElementById('mobileDrawer');
  if (mobileMenuBtn && mobileDrawer) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileDrawer.classList.toggle('hidden');
    });
  }

  function toggleMobileNav() {
    if (mobileDrawer) mobileDrawer.classList.add('hidden');
  }

  // 4. Fallback execution of ThreeJS Erythrocyte Scene inside #threejs-bio-centerpiece if custom element isn't handled by host
  window.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('threejs-bio-centerpiece');
    if (container && window.THREE && !container.querySelector('canvas')) {
      try {
        const width = container.clientWidth || 480;
        const height = container.clientHeight || 500;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
        camera.position.set(0, 0, 8.5);

        const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: "high-performance" });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        function createBiconcaveErythrocyte(radius = 1.6, thickness = 0.55, segments = 48) {
          const geom = new THREE.SphereGeometry(radius, segments, segments);
          const pos = geom.attributes.position;
          for (let i = 0; i < pos.count; i++) {
            let x = pos.getX(i);
            let y = pos.getY(i);
            let z = pos.getZ(i);
            let r = Math.sqrt(x * x + y * y);
            let normR = r / radius;
            let dimple = 0.35 + 1.2 * (normR * normR) - 0.7 * (normR * normR * normR * normR);
            pos.setZ(i, z * dimple * thickness);
          }
          geom.computeVertexNormals();
          return geom;
        }

        const cellGroup = new THREE.Group();
        scene.add(cellGroup);

        const cellMaterial = new THREE.MeshPhysicalMaterial({
          color: new THREE.Color(0xd90429),
          emissive: new THREE.Color(0x38040e),
          roughness: 0.18,
          metalness: 0.05,
          transmission: 0.65,
          ior: 1.38,
          thickness: 1.2,
          clearcoat: 0.8
        });

        const mainCell = new THREE.Mesh(createBiconcaveErythrocyte(1.75, 0.65, 64), cellMaterial);
        cellGroup.add(mainCell);

        const ambientLight = new THREE.AmbientLight(0x22050b, 3.0);
        scene.add(ambientLight);

        const rimLight = new THREE.DirectionalLight(0xff1e44, 4.5);
        rimLight.position.set(4, 5, 4);
        scene.add(rimLight);

        const backLight = new THREE.PointLight(0xff0040, 4.0, 15);
        backLight.position.set(-4, -2, -3);
        scene.add(backLight);

        let clock = new THREE.Clock();
        function animateCell() {
          requestAnimationFrame(animateCell);
          const t = clock.getElapsedTime();
          mainCell.rotation.x = Math.sin(t * 0.4) * 0.35;
          mainCell.rotation.y = t * 0.35;
          const pulse = Math.pow(Math.sin(t * 3.76), 10) * 0.08;
          mainCell.scale.set(1 + pulse, 1 + pulse, 1 + pulse);
          renderer.render(scene, camera);
        }
        animateCell();

        window.addEventListener('resize', () => {
          const w = container.clientWidth;
          const h = container.clientHeight;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h);
        });
      } catch (err) {
        console.warn('Three.js initialized directly or handled by element.', err);
      }
    }
  });
</script>
