@{
    ViewData["Title"] = "FAQ";
    var faqs = new[]
    {
        new { Q = "Who can donate blood?", A = "Generally, anyone aged 18–65, weighing at least 50 kg, and in good health can donate blood. Certain medical conditions and medications may disqualify you — consult your doctor if unsure." },
        new { Q = "How often can I donate blood?", A = "Whole blood: every 3 months (90 days). Platelets: every 2 weeks, up to 24 times a year. Plasma: every 28 days. Your body replenishes blood within weeks." },
        new { Q = "Is donating blood safe?", A = "Absolutely. Sterile, single-use needles are used for every donor. The entire process takes 30–45 minutes and typically causes no lasting effects. Light dizziness may occur briefly." },
        new { Q = "How does BloodConnect verify donors?", A = "Every donor registers with a verified email, and every donation is a two-step confirmed process: the donor pledges, the requester accepts, and both confirm before the donation is marked complete." },
        new { Q = "Is my contact information visible to everyone?", A = "No. Your phone number is only revealed after a requester accepts your offer. Before that, only your name, blood group, and location are visible." },
        new { Q = "Does BloodConnect charge anything?", A = "No. BloodConnect is free forever. There are no premium tiers, ads, or hidden fees. We exist purely to connect donors and patients." },
        new { Q = "What if I can't donate after accepting a request?", A = "Communicate promptly with the requester. Life happens — health issues, emergencies. Just be transparent so they can find another donor in time." },
        new { Q = "Can I donate for a specific person?", A = "Yes. Look for their blood request on the Blood Requests page, click 'I can donate', and they'll be notified. Once they accept, you can coordinate directly." },
        new { Q = "How do I know a request is real?", A = "All requests come from registered users and are visible with requester name and location. Our admins monitor the platform and can remove spam or fake requests." },
        new { Q = "I found a bug or have feedback. Where do I report?", A = "Please use our Contact page — we read every message. Bug reports, feature ideas, and criticism all help make BloodConnect better." }
    };
}

<section class="faq-hero">
    <div class="container">
        <span class="section-eyebrow">FREQUENTLY ASKED</span>
        <h1>Questions, answered.</h1>
        <p>Everything you wanted to know about donating blood through BloodConnect.</p>
    </div>
</section>

<div class="container py-5">
    <div class="faq-list">
        @for (int i = 0; i < faqs.Length; i++)
        {
            var faq = faqs[i];
            var id = "faq-" + i;
            <div class="faq-item">
                <button class="faq-question" type="button" data-bs-toggle="collapse"
                        data-bs-target="#@id" aria-expanded="false" aria-controls="@id">
                    <span class="faq-num">@((i + 1).ToString("D2"))</span>
                    <span class="faq-text">@faq.Q</span>
                    <span class="faq-chevron">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </span>
                </button>
                <div id="@id" class="collapse faq-answer">
                    <div class="faq-answer-inner">@faq.A</div>
                </div>
            </div>
        }
    </div>

    <div class="faq-cta">
        <h3>Still have questions?</h3>
        <p>We're here to help.</p>
        <a asp-controller="Home" asp-action="Contact" class="btn btn-danger">Contact Us</a>
    </div>
</div>