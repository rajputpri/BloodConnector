@model BloodConnect.Models.Donor
@using BloodConnect.Models

<div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="donorFormErrors"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label">Full Name</label>
        <input asp-for="Name" class="form-control" placeholder="Your full name" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Age" class="form-label">Age</label>
        <input asp-for="Age" type="number" min="18" max="65"
               class="form-control" placeholder="Between 18 and 65" />
        <span asp-validation-for="Age" class="text-danger small"></span>
        <div class="form-text">Donors must be between 18 and 65 years old.</div>
    </div>

    <div class="col-md-6">
        <label asp-for="BloodGroup" class="form-label">Blood Group</label>
        <select asp-for="BloodGroup" class="form-select">
            <option value="">-- Select blood group --</option>
            @foreach (var bg in DomainValues.BloodGroups)
            {
                <option value="@bg">@bg</option>
            }
        </select>
        <span asp-validation-for="BloodGroup" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ContactNumber" class="form-label">Contact Number</label>
        <input asp-for="ContactNumber" class="form-control"
               maxlength="10" inputmode="numeric"
               placeholder="10-digit mobile number" />
        <span asp-validation-for="ContactNumber" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="State" class="form-label">State / UT</label>
        <select asp-for="State" class="form-select" required>
            <option value="">-- Select state --</option>
            @foreach (var s in DomainValues.IndianStates)
            {
                <option value="@s">@s</option>
            }
        </select>
        <span asp-validation-for="State" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="City" class="form-label">City</label>
        <input asp-for="City" class="form-control" maxlength="50"
               placeholder="e.g. Ahmedabad" autocomplete="address-level2" required />
        <span asp-validation-for="City" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="IsAvailable" class="form-check-input" />
            <label asp-for="IsAvailable" class="form-check-label">
                I'm currently available to donate
            </label>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const summary = document.getElementById('donorFormErrors');
        if (summary && summary.querySelector('ul li')) {
            summary.classList.remove('d-none');
        }
    });
</script>