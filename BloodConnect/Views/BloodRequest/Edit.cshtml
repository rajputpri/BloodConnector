@model BloodConnect.Models.BloodRequest

<h2>Edit Blood Request</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="RequestId" />

    <div>
        <label>Requester Name:</label>
        <input asp-for="RequesterName" />
        <span asp-validation-for="RequesterName" style="color:red"></span>
    </div>

    <div>
        <label>Blood Group Needed:</label>
        <select asp-for="BloodGroupNeeded">
            <option value="">-- Select Blood Group --</option>
            <option value="A+">A+</option>
            <option value="A-">A-</option>
            <option value="B+">B+</option>
            <option value="B-">B-</option>
            <option value="AB+">AB+</option>
            <option value="AB-">AB-</option>
            <option value="O+">O+</option>
            <option value="O-">O-</option>
        </select>
        <span asp-validation-for="BloodGroupNeeded" style="color:red"></span>
    </div>

    <div>
        <label>Location:</label>
        <input asp-for="Location" />
        <span asp-validation-for="Location" style="color:red"></span>
    </div>

    <div>
        <label>Contact Number:</label>
        <input asp-for="ContactNumber" maxlength="10" inputmode="numeric" />
        <span asp-validation-for="ContactNumber" style="color:red"></span>
    </div>

    <div>
        <label>Urgency Level:</label>
        <select asp-for="UrgencyLevel">
            <option value="">-- Select Urgency --</option>
            <option value="Low">Low</option>
            <option value="Medium">Medium</option>
            <option value="High">High</option>
            <option value="Critical">Critical</option>
        </select>
        <span asp-validation-for="UrgencyLevel" style="color:red"></span>
    </div>

    <button type="submit">Save Changes</button>

</form>

<a asp-action="Index">Back to Requests List</a>