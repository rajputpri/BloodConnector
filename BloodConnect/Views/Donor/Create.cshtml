@model BloodConnect.Models.Donor

<h2>Add New Donor</h2>

<form asp-action="Create" method="post">

    <div>
        <label>Name:</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" style="color:red"></span>
    </div>

    <div>
        <label>Blood Group:</label>
        <select asp-for="BloodGroup">
            <option value="">-- Select Blood Group --</option>
            <option value="A+">A+</option>
            <option value="A-">A-</option>
            <option value="B+">B+</option>
            <option value="B-">B-</option>
            <option value="AB+">AB+</option>
            <option value="AB-">AB-</option>
            <option value="O+">O+</option>
            <option value="O-">O-</option>
        </select>
        <span asp-validation-for="BloodGroup" style="color:red"></span>
    </div>

    <div>
        <label>Location:</label>
        <input asp-for="Location" />
        <span asp-validation-for="Location" style="color:red"></span>
    </div>

    <div>
        <label>Contact Number:</label>
        <input asp-for="ContactNumber" maxlength="10" inputmode="numeric" />
        <span asp-validation-for="ContactNumber" style="color:red"></span>
    </div>

    <div>
        <label>Available:</label>
        <input asp-for="IsAvailable" type="checkbox" />
    </div>

    <button type="submit">Register Donor</button>

</form>

<a asp-action="Index">Back to Donor List</a>