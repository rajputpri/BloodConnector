@model List<BloodConnect.Models.Donor>

<h2>Donor List</h2>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Blood Group</th>
        <th>Location</th>
        <th>Contact</th>
        <th>Available</th>
    </tr>

    @foreach (var donor in Model)
    {
        <tr>
            <td>@donor.DonorId</td>
            <td>@donor.Name</td>
            <td>@donor.BloodGroup</td>
            <td>@donor.Location</td>
            <td>@donor.ContactNumber</td>
            <td>@(donor.IsAvailable ? "Yes" : "No")</td>
        </tr>
    }
</table>